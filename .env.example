APP_NAME="Tender Aggregator"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Dar_es_Salaam

# --- Tender sources (see config/tenders.php) ---
# Cron expression for the scheduled `tenders:fetch` run (every 6 hours by default).
TENDERS_FETCH_CRON="0 */6 * * *"

# World Bank: works out of the box. `qterm` full-text filter; blank = all countries.
WORLD_BANK_QUERY=Tanzania

# ReliefWeb: needs a pre-approved appname since 2025-11-01. Request one at
# https://apidoc.reliefweb.int/parameters#appname — until then this source is skipped.
RELIEFWEB_APPNAME=

# TANePS: no public API. Set this to the classic server-rendered listing URL
# once confirmed (not the JS dashboard). Blank = skipped.
TANEPS_LISTING_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tender_aggregator
DB_USERNAME=root
DB_PASSWORD=

LOG_CHANNEL=stack

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log

# There is no public registration. The UserSeeder creates this admin
# account on `php artisan db:seed`; change these before seeding.
ADMIN_NAME="Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
